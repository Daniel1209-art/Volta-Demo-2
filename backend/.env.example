# VOLTA backend — рабочие дефолты. Скопируй в .env при необходимости.
# Секретов здесь нет: приватные seed-ы раундов генерируются в рантайме.

# Порт/адрес бэкенда. Наружу не выставляется — nginx проксирует /ws и /api.
PORT=8090
HOST=127.0.0.1

# Файл SQLite (создаётся автоматически; папка data/ в .gitignore).
#DB_PATH=/var/www/volta-demo.com/data/volta.db

# Часовой пояс суточного сброса «My Game History» (IANA-имя). По ТЗ — UTC.
RESET_TZ=UTC

# Сколько последних раундов отдавать клиенту для полосы истории.
HISTORY_LEN=50

# 1 = раздавать frontend/ и shared/ прямо из Node (только локальная разработка).
#SERVE_STATIC=1
